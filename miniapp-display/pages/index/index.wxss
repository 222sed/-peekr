/* Food state extracted from Figma Make: happy head dip + bowl with paws */
.animated-cat-food {
  animation: foodCatBreath 2.24s ease-in-out infinite;
}

.food-tail {
  animation: foodTailSway 2.38s ease-in-out infinite;
}

.food-body {
