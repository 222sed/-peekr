<view class="page">

  <view wx:if="{{!hasProfile}}" class="designer">
    <view class="designer-stage">
      <view class="designer-topbar">
        <view class="designer-heading">
          <view class="dash-brand-lockup">
            <text class="dash-brand-name">Peekr</text>
            <view class="dash-brand-tail"></view>
          </view>
          <text class="designer-title">创建猫咪形象</text>
          <text class="designer-subtitle">先选择最接近的外观，之后可以随时调整</text>
        </view>
        <button class="designer-info" data-action="info" bindtap="onToolTap">说明</button>
      </view>

      <view class="name-editor">
        <text class="name-label">猫咪名字</text>
        <input class="name-input" aria-label="猫咪名字" value="{{catProfile.name}}" maxlength="8" placeholder="例如：小灰" bindinput="onNameInput" />
      </view>

      <view class="cat-showcase">
        <view class="cat-shadow"></view>
        <image class="cat-figure" src="{{catPreview.bodySrc}}" mode="aspectFit" />
      </view>

      <view class="designer-actions">
        <button class="designer-secondary" data-action="camera" bindtap="onToolTap">拍照生成</button>
        <button class="designer-primary" data-action="save" bindtap="onToolTap">保存形象</button>
      </view>
    </view>

    <view class="designer-tabs" aria-role="tablist">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="designer-tab {{activeCategory === item.key ? 'active' : ''}}"
        aria-role="tab"
        aria-selected="{{activeCategory === item.key}}"
        data-key="{{item.key}}"
        bindtap="onSelectCategory"
      >
        <text class="designer-tab-label">{{item.label}}</text>
      </view>
    </view>

    <scroll-view class="designer-panel" scroll-y="true">
      <view class="current-summary">
        <view class="summary-chip" wx:for="{{selectedSummary}}" wx:key="key">
          <text class="summary-chip-label">{{item.label}}</text>
          <text class="summary-chip-value">{{item.value}}</text>
        </view>
      </view>

      <view class="asset-grid">
        <view
          wx:for="{{activeOptions}}"
          wx:key="value"
          class="asset-card {{item.selected ? 'active' : ''}}"
          aria-role="button"
          aria-label="{{item.label}}{{item.selected ? '，已选择' : ''}}"
          data-field="{{activeCategory}}"
          data-value="{{item.value}}"
          bindtap="onSelectOption"
        >
          <view class="asset-preview">
            <image wx:if="{{item.previewSrc}}" class="asset-img" src="{{item.previewSrc}}" mode="aspectFit" />
            <view wx:elif="{{item.swatch}}" class="asset-swatch" style="background:{{item.swatch}}"></view>
            <text wx:else class="asset-mark">{{item.mark}}</text>
          </view>
          <text class="asset-title">{{item.label}}</text>
          <text class="asset-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <block wx:else>
    <view class="home-page dashboard-page">
      <view class="dash-header">
        <view class="dash-identity">
          <view class="dash-brand-lockup">
            <text class="dash-brand-name">Peekr</text>
            <view class="dash-brand-tail"></view>
          </view>
          <text class="dash-name">{{catProfile.name}}</text>
        </view>
        <button class="dash-setting" aria-label="打开展示设置" bindtap="onOpenSettings">
          <view class="settings-glyph" aria-hidden="true">
            <view class="settings-line settings-line-top"></view>
            <view class="settings-line settings-line-bottom"></view>
          </view>
        </button>
      </view>

      <view class="settings-mask" wx:if="{{settingsOpen}}" bindtap="onCloseSettings"></view>
      <view class="settings-popover" wx:if="{{settingsOpen}}" aria-role="dialog" aria-label="展示设置">
        <view class="settings-popover-head">
          <view>
            <view class="settings-popover-title">展示设置</view>
            <view class="settings-popover-desc">切换演示状态，不会写入真实记录</view>
          </view>
          <button class="settings-popover-close" aria-label="关闭设置" bindtap="onCloseSettings">
            <view class="close-glyph" aria-hidden="true"></view>
          </button>
        </view>

        <view class="settings-option" aria-role="switch" aria-checked="{{testMode}}" bindtap="onToggleTestMode">
          <view class="settings-option-main">
            <view>
              <view class="settings-option-title">测试模式</view>
              <view class="settings-option-desc">
                {{testMode ? '模拟状态每秒轮换，仅在本机显示' : '预览休息、活动、进食与低活动状态'}}
              </view>
            </view>
          </view>
          <view class="settings-switch {{testMode ? 'on' : ''}}">
            <view class="settings-switch-dot"></view>
          </view>
        </view>
      </view>

      <view class="hero-card status-{{statusVariant}}">
        <view class="hero-copy">
          <view class="hero-status-line">
            <view class="hero-status-mark"></view>
            <text>{{testMode ? '演示数据' : stateLabel}}</text>
          </view>
          <text class="hero-state">{{heroTitle}}</text>
          <text class="hero-desc">{{stateDesc}}</text>
          <text class="hero-freshness">{{freshnessText}}</text>
          <view class="status-trail"></view>
        </view>

        <view class="overview-stage">
          <view class="overview-copy">
            <text class="overview-label">今日记录概况</text>
            <text class="overview-note">基于已记录时段 · 非健康评分</text>
          </view>
          <view class="overview-arc arc-outer"></view>
          <view class="overview-arc arc-middle"></view>
          <view class="overview-arc arc-inner"></view>

          <view class="hero-cat state-{{state}}">
          <view wx:if="{{state === 'sleep'}}" class="animated-cat animated-cat-sleep">
            <image class="cat-part sleep-tail" src="{{animatedCatParts.sleepTail}}" mode="aspectFit" />
            <image class="cat-part sleep-body" src="{{animatedCatParts.sleepBody}}" mode="aspectFit" />
            <image class="cat-part sleep-head" src="{{animatedCatParts.sleepHead}}" mode="aspectFit" />
            <view class="sleep-zzz z1">Z</view>
            <view class="sleep-zzz z2">Z</view>
            <view class="sleep-zzz z3">Z</view>
          </view>

          <view wx:elif="{{state === 'play'}}" class="animated-cat animated-cat-play">
            <image class="cat-part cat-tail" src="{{animatedCatParts.tail}}" mode="aspectFit" />
            <image class="cat-part cat-body" src="{{animatedCatParts.body}}" mode="aspectFit" />
            <image class="cat-part play-head" src="{{animatedCatParts.playHead}}" mode="aspectFit" />
            <image class="cat-part play-paw" src="{{animatedCatParts.playPaw}}" mode="aspectFit" />
            <image class="cat-part play-paw-right" src="{{animatedCatParts.playPaw}}" mode="aspectFit" />
            <image class="cat-part yarn-ball" src="{{animatedCatParts.yarn}}" mode="aspectFit" />
            <view class="impact-lines"></view>
          </view>

          <view wx:elif="{{state === 'food'}}" class="animated-cat animated-cat-food">
            <image class="cat-part cat-tail food-tail" src="{{animatedCatParts.tail}}" mode="aspectFit" />
            <image class="cat-part cat-body food-body" src="{{animatedCatParts.body}}" mode="aspectFit" />
            <image class="cat-part food-head" src="{{animatedCatParts.foodHead}}" mode="aspectFit" />
            <image class="cat-part food-bowl-img" src="{{animatedCatParts.foodBowl}}" mode="aspectFit" />
            <view class="munch-bit bit1"></view>
            <view class="munch-bit bit2"></view>
          </view>

          <view wx:else class="animated-cat animated-cat-groom">
            <image class="cat-part cat-tail" src="{{animatedCatParts.tail}}" mode="aspectFit" />
            <image class="cat-part cat-body" src="{{animatedCatParts.body}}" mode="aspectFit" />
            <image class="cat-part cat-paw" src="{{animatedCatParts.paw}}" mode="aspectFit" />
            <view class="cat-head-wrap">
              <image class="cat-part cat-head" src="{{animatedCatParts.head}}" mode="aspectFit" />
              <view class="cat-tongue"></view>
            </view>
          </view>
          </view>
        </view>
      </view>

      <view class="status-panel">
        <view class="section-head">
          <view>
            <text class="section-title">今天的三项记录</text>
            <text class="section-caption">满格不代表更好，暂无参考时只展示记录</text>
          </view>
          <text class="section-note">{{deviceNote}}</text>
        </view>

        <view class="behavior-row {{item.unavailable ? 'unavailable' : ''}}" wx:for="{{metrics}}" wx:key="key">
          <view class="behavior-head">
            <view class="behavior-name">
              <view class="behavior-mark {{item.colorClass}}" aria-hidden="true"></view>
              <text class="behavior-label">{{item.label}}</text>
            </view>
            <text class="behavior-value">{{item.valueText}}</text>
          </view>
          <view class="behavior-track">
            <view class="behavior-range"></view>
            <view class="behavior-fill {{item.colorClass}}" style="width:{{item.barValue}}%"></view>
          </view>
          <text class="behavior-helper">{{item.helper}}</text>
        </view>
      </view>

      <view class="timeline-panel">
        <view class="section-head">
          <text class="section-title">今日时间轴</text>
          <text class="section-note">{{hasTimelineData ? '00:00 - 现在' : '暂无时段'}}</text>
        </view>
        <view class="timeline-track" wx:if="{{hasTimelineData}}">
          <view
            wx:for="{{timeline}}"
            wx:key="index"
            class="timeline-seg timeline-{{item.type}}"
            style="width:{{item.pct}}%"
          ></view>
        </view>
        <view class="timeline-empty" wx:else>采集到有效画面后，这里会显示今天的行为分布</view>
        <view class="timeline-legend" wx:if="{{hasTimelineData}}">
          <view><text class="legend-mark sleep"></text><text>休息</text></view>
          <view><text class="legend-mark play"></text><text>活动</text></view>
          <view><text class="legend-mark food"></text><text>进食</text></view>
          <view><text class="legend-mark dream"></text><text>低活动</text></view>
        </view>
      </view>

      <view class="notice-card status-{{statusVariant}}" aria-role="alert" wx:if="{{statusVariant === 'offline' || statusVariant === 'server-error' || statusVariant === 'stale'}}">
        <view class="notice-copy">
          <text class="notice-title">{{heroTitle}}</text>
          <text>{{stateDesc}}</text>
        </view>
        <button class="notice-action" bindtap="onRetryConnection">{{statusVariant === 'stale' ? '立即刷新' : '重新连接'}}</button>
      </view>

      <view class="customize-entry" aria-role="button" bindtap="onEditCatProfile">
        <text>自定义 {{catProfile.name}} 的形象</text>
        <text class="entry-arrow">→</text>
      </view>
    </view>
  </block>

</view>
