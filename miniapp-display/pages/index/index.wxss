/* Play state extracted from Figma Make: batting paw + yarn ball */
.animated-cat-play {
  animation: playCatFloat 1.1s ease-in-out infinite;
}

.animated-cat-play .cat-tail {
  animation: playTailFlick 1.76s ease-in-out infinite;
}

.play-head {
  z-index: 5;
