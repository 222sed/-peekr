@keyframes breathe {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(1.04); }
}

@keyframes bodySway {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(1.8deg); }
  75% { transform: rotate(-1.8deg); }
}

@keyframes munchBob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(7rpx); }
}

@keyframes dreamFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}

@keyframes figmaCatBreath {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-50%, -50%) scale(1.025); }
}

@keyframes figmaCatSleep {
  0%, 100% { transform: translate(-50%, -50%) translateY(0) scale(1); }
  50% { transform: translate(-50%, -50%) translateY(8rpx) scale(1.018, 0.988); }
}

@keyframes figmaCatPlay {
  0%, 100% { transform: translate(-50%, -50%) translateY(0) rotate(0deg) scale(1); }
  25% { transform: translate(-50%, -50%) translateY(-10rpx) rotate(-2deg) scale(1.02); }
  50% { transform: translate(-50%, -50%) translateY(0) rotate(1.5deg) scale(1); }
  75% { transform: translate(-50%, -50%) translateY(-6rpx) rotate(2deg) scale(1.015); }
}

@keyframes figmaCatIdle {
  0%, 100% { transform: translate(-50%, -50%) translateY(0); }
  50% { transform: translate(-50%, -50%) translateY(-12rpx); }
}

@keyframes figmaTailSway {
  0%, 100% { transform: rotate(0deg); }
  22% { transform: rotate(7deg); }
  50% { transform: rotate(-3deg); }
  78% { transform: rotate(6deg); }
}

@keyframes figmaPawGroom {
  0%, 100% { transform: translate(0, 0) rotate(-14deg); }
  25% { transform: translate(8rpx, -7rpx) rotate(-22deg); }
  50% { transform: translate(5rpx, -3rpx) rotate(-18deg); }
  75% { transform: translate(8rpx, -7rpx) rotate(-22deg); }
}

@keyframes figmaHeadLick {
  0%, 100% { transform: translate(0, 0) rotate(-3deg); }
  25% { transform: translate(-8rpx, 16rpx) rotate(-16deg); }
  50% { transform: translate(-5rpx, 11rpx) rotate(-12deg); }
  75% { transform: translate(-8rpx, 16rpx) rotate(-16deg); }
}

@keyframes figmaTongueFlick {
  0%, 24%, 100% { transform: scaleY(0); opacity: 0; }
  50% { transform: scaleY(1); opacity: 1; }
  70% { transform: scaleY(0.4); opacity: 1; }
}

@keyframes sleepCatBreath {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-50%, -50%) scale(1.012, 1.025); }
}

@keyframes sleepTailSway {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(4deg); }
  50% { transform: rotate(-2deg); }
  78% { transform: rotate(3deg); }
}

@keyframes sleepHeadNod {
  0% { transform: translateY(0) rotate(0deg) scaleY(1); }
  35% { transform: translateY(38rpx) rotate(4deg) scaleY(0.96); }
  46% { transform: translateY(12rpx) rotate(-2deg) scaleY(1); }
  78% { transform: translateY(42rpx) rotate(5deg) scaleY(0.95); }
  100% { transform: translateY(28rpx) rotate(2deg) scaleY(0.97); }
}

@keyframes sleepZFloat {
  0% { opacity: 0; transform: translate(0, 0) scale(0.7) rotate(-6deg); }
  25% { opacity: 0.9; }
  100% { opacity: 0; transform: translate(18rpx, -52rpx) scale(1.1) rotate(6deg); }
}

@keyframes playCatFloat {
  0%, 100% { transform: translate(-50%, -50%) translateY(0) scale(1); }
  25% { transform: translate(-50%, -50%) translateY(-8rpx) scale(1.02); }
  50% { transform: translate(-50%, -50%) translateY(0) scale(1); }
  75% { transform: translate(-50%, -50%) translateY(-5rpx) scale(1.015); }
}

@keyframes playTailFlick {
  0%, 100% { transform: rotate(0deg); }
  30% { transform: rotate(16deg); }
  50% { transform: rotate(-6deg); }
  80% { transform: rotate(14deg); }
}

@keyframes playHeadBob {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  30% { transform: translateY(-5rpx) rotate(6deg); }
  50% { transform: translateY(0) rotate(-2deg); }
  80% { transform: translateY(-4rpx) rotate(5deg); }
}

@keyframes playPawBat {
  0%, 100% { transform: rotate(4deg); }
  30% { transform: rotate(34deg); }
  50% { transform: rotate(4deg); }
  80% { transform: rotate(30deg); }
}

@keyframes playPawRightBat {
  0%, 100% { transform: rotate(12deg); }
  30% { transform: rotate(38deg); }
  50% { transform: rotate(14deg); }
  80% { transform: rotate(32deg); }
}

@keyframes yarnDrift {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  32% { transform: translate(32rpx, -42rpx) rotate(160deg); }
  50% { transform: translate(5rpx, 8rpx) rotate(250deg); }
  80% { transform: translate(28rpx, -34rpx) rotate(360deg); }
}

@keyframes impactPop {
  0%, 100% { opacity: 0; transform: scale(0.5); }
  30% { opacity: 1; transform: scale(1.25); }
  55% { opacity: 0; transform: scale(0.7); }
}

@keyframes foodCatBreath {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-50%, -50%) scale(1.02); }
}

@keyframes foodTailSway {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(9deg); }
  50% { transform: rotate(-3deg); }
  78% { transform: rotate(7deg); }
}

@keyframes foodHeadDip {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  22% { transform: translateY(52rpx) rotate(0deg); }
  38% { transform: translateY(48rpx) rotate(-1.5deg); }
  54% { transform: translateY(52rpx) rotate(0deg); }
  70% { transform: translateY(48rpx) rotate(-1.5deg); }
}

@keyframes foodBowlWiggle {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-3rpx) rotate(1.5deg); }
  50% { transform: translateY(1rpx) rotate(-1.5deg); }
  75% { transform: translateY(-2rpx) rotate(1deg); }
}

@keyframes munchBit {
  0% { opacity: 0; transform: translate(0, 0) scale(0.6); }
  30% { opacity: 1; transform: translate(10rpx, -18rpx) scale(1); }
  100% { opacity: 0; transform: translate(5rpx, -30rpx) scale(0.5); }
}

@keyframes munchBitAlt {
  0% { opacity: 0; transform: translate(0, 0) scale(0.6); }
  30% { opacity: 1; transform: translate(-10rpx, -16rpx) scale(1); }
  100% { opacity: 0; transform: translate(-4rpx, -28rpx) scale(0.5); }
}

@keyframes zFloat {
  0% { opacity: 0; transform: translateY(16rpx) scale(0.85); }
  25% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-28rpx) scale(1.12); }
}

@keyframes sparkleMove {
  0%, 100% { opacity: 0.25; transform: scale(0.7); }
  50% { opacity: 1; transform: scale(1.18); }
}

@keyframes foodNibble {
  0%, 100% { transform: translateY(0); opacity: 0.68; }
  50% { transform: translateY(-8rpx); opacity: 1; }
}

@keyframes bubbleFloat {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.82; }
  50% { transform: translateY(-10rpx) scale(1.05); opacity: 1; }
}

/* Dashboard v3: editorial companion overview */
.dashboard-page {
