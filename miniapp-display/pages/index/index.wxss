/* Figma Make animated cat: role only, no exported background */
.hero-cat {
  position: relative;
  display: block;
  width: 420rpx;
  height: 500rpx;
  margin: 0 auto 0;
  filter: none;
}

.animated-cat {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 420rpx;
  height: 500rpx;
  transform: translate(-50%, -50%);
  transform-origin: 50% 86%;
  filter: drop-shadow(0 28rpx 28rpx rgba(38, 91, 105, 0.18));
  animation: figmaCatBreath 3.6s ease-in-out infinite;
}

.cat-part,
.cat-head-wrap {
  position: absolute;
  display: block;
  will-change: transform, opacity;
}

.cat-tail {
  z-index: 1;
  left: 226rpx;
  top: 238rpx;
  width: 220rpx;
  height: 176rpx;
  transform-origin: 10% 60%;
  animation: figmaTailSway 4.5s ease-in-out infinite;
}

.cat-body {
  z-index: 2;
  left: 80rpx;
  top: 172rpx;
  width: 312rpx;
  height: 300rpx;
}

.cat-paw {
  z-index: 8;
  left: 134rpx;
  top: 208rpx;
  width: 108rpx;
  height: 180rpx;
  transform-origin: 28% 94%;
  animation: figmaPawGroom 2.4s ease-in-out infinite;
}

.cat-head-wrap {
  z-index: 6;
  left: 100rpx;
  top: 28rpx;
  width: 264rpx;
  height: 240rpx;
  transform-origin: 50% 92%;
  animation: figmaHeadLick 2.4s ease-in-out infinite;
}

.cat-head {
  width: 100%;
  height: 100%;
}

.cat-tongue {
  position: absolute;
  left: 126rpx;
  top: 160rpx;
  width: 20rpx;
  height: 28rpx;
  border-radius: 50% 50% 48% 48%;
  background: #FFA5A5;
  transform-origin: 50% 0%;
  opacity: 0;
  animation: figmaTongueFlick 2.4s ease-in-out infinite;
}

.cat-tongue::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 5rpx;
  width: 2rpx;
  height: 18rpx;
  border-radius: 2rpx;
  background: #E88E96;
}

.hero-cat.state-play .animated-cat {
  animation: figmaCatPlay 1s ease-in-out infinite;
}

.hero-cat.state-sleep .animated-cat {
  animation: figmaCatSleep 3.4s ease-in-out infinite;
}

.hero-cat.state-food .cat-head-wrap,
.hero-cat.state-food .cat-paw,
.hero-cat.state-food .cat-tongue {
  animation-duration: 1.2s;
}

.hero-cat.state-dream .animated-cat,
.hero-cat.state-unknown .animated-cat {
  animation: figmaCatIdle 3.8s ease-in-out infinite;
}

.hero-cat.state-unknown .animated-cat {
  opacity: 0.78;
}

/* Sleep state extracted from Figma Make: lying body + sleepy nod + Zzz */
.animated-cat-sleep {
  width: 500rpx;
  height: 420rpx;
  animation: sleepCatBreath 3.8s ease-in-out infinite;
}

.sleep-tail {
  z-index: 1;
  left: 312rpx;
