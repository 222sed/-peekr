.dash-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 34rpx;
}

.dash-identity {
  display: flex;
  align-items: flex-end;
  gap: 22rpx;
  min-width: 0;
}

.dash-brand-lockup {
