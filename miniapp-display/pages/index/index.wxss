.settings-glyph {
  position: relative;
  width: 34rpx;
  height: 28rpx;
  margin: 0 auto;
}

.settings-line {
  position: absolute;
  left: 0;
  width: 34rpx;
  height: 3rpx;
  border-radius: 4rpx;
  background: #222220;
}

.settings-line::after {
  content: '';
  position: absolute;
  top: -5rpx;
  width: 11rpx;
  height: 11rpx;
  box-sizing: border-box;
  border: 3rpx solid #222220;
  border-radius: 50%;
  background: #F7F5F0;
