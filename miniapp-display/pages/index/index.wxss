}

.settings-line-top::after {
  left: 7rpx;
}

.settings-line-bottom {
  bottom: 4rpx;
}

.settings-line-bottom::after {
  right: 6rpx;
}

.settings-mask {
  background: rgba(34, 34, 32, 0.12);
}

.settings-popover {
  top: 126rpx;
  right: 40rpx;
  width: 560rpx;
  max-width: calc(100vw - 80rpx);
  border: 1rpx solid #E4E1DA;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 18rpx 42rpx rgba(34, 34, 32, 0.14);
}

.settings-popover-title,
.settings-option-title {
  color: #222220;
}

.settings-popover-desc,
.settings-option-desc {
  color: #686963;
}

.settings-popover-close {
  width: 88rpx;
  height: 88rpx;
  background: #F7F5F0;
  color: #686963;
  line-height: 84rpx;
}

.settings-popover-close::after {
  border: 0;
}

.settings-option {
  min-height: 88rpx;
  border: 1rpx solid #E4E1DA;
  background: #FFFFFF;
  box-shadow: none;
}

.settings-option-icon {
  background: #F7F5F0;
  color: #222220;
}

.settings-switch.on {
  background: #F05F65;
}

.hero-card {
  min-height: 0;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.hero-copy {
  position: relative;
  z-index: 4;
  min-width: 0;
}

.hero-status-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #686963;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.hero-status-mark {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #5DB8A8;
}

.status-offline .hero-status-mark,
.status-stale .hero-status-mark,
.status-server-error .hero-status-mark {
  background: #F05F65;
}

.status-not-found .hero-status-mark,
.status-waiting .hero-status-mark {
  background: #A6A49E;
}

.hero-state {
  display: block;
  max-width: 620rpx;
  margin-top: 10rpx;
  color: #222220;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.14;
  text-align: left;
}

.hero-desc {
  display: block;
  max-width: 620rpx;
  margin: 14rpx 0 0;
  color: #686963;
  font-size: 27rpx;
  line-height: 1.55;
  text-align: left;
}

.hero-freshness {
  display: block;
  margin-top: 8rpx;
  color: #686963;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.45;
}

.status-trail {
  width: 116rpx;
  height: 22rpx;
  margin-top: 12rpx;
  border-top: 5rpx solid #F05F65;
  border-radius: 50%;
  transform: rotate(-5deg);
}

.overview-stage {
  position: relative;
  height: 432rpx;
  margin-top: -8rpx;
  overflow: hidden;
}

.overview-copy {
  position: absolute;
  z-index: 4;
  top: 28rpx;
  left: 0;
}

.overview-label,
.overview-note {
  display: block;
}

.overview-label {
  color: #222220;
  font-size: 24rpx;
  font-weight: 650;
}

.overview-note {
  margin-top: 5rpx;
  color: #686963;
  font-size: 24rpx;
}

.overview-arc {
  position: absolute;
  left: 50%;
  box-sizing: border-box;
  border-style: solid;
  border-bottom: 0;
  transform: translateX(-50%);
  pointer-events: none;
}

.arc-outer {
  top: 70rpx;
  width: 526rpx;
  height: 270rpx;
  border-width: 8rpx;
  border-color: #F05F65;
  border-radius: 270rpx 270rpx 0 0;
}

.arc-middle {
  top: 102rpx;
  width: 460rpx;
  height: 236rpx;
  border-width: 7rpx;
  border-color: #9B97B0;
  border-radius: 236rpx 236rpx 0 0;
}

.arc-inner {
  top: 134rpx;
  width: 396rpx;
  height: 202rpx;
  border-width: 7rpx;
  border-color: #5DB8A8;
  border-radius: 202rpx 202rpx 0 0;
}

.overview-stage .hero-cat {
  position: absolute;
  z-index: 3;
  left: 50%;
  bottom: -30rpx;
  width: 420rpx;
  height: 500rpx;
  margin: 0 0 0 -210rpx;
  transform: scale(0.78);
  transform-origin: 50% 100%;
  filter: none;
}

.overview-stage .animated-cat {
  filter: none;
}

.status-offline .overview-arc,
.status-stale .overview-arc,
.status-server-error .overview-arc,
.status-waiting .overview-arc {
  border-color: #CECCC6;
}

.status-offline .animated-cat,
.status-stale .animated-cat,
.status-server-error .animated-cat,
.status-waiting .animated-cat {
  animation: none;
  opacity: 0.54;
}

.status-not-found .animated-cat {
  opacity: 0.66;
}

.status-panel {
  margin-top: 0;
  padding: 30rpx 0 0;
  border: 0;
  border-top: 1rpx solid #E4E1DA;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.section-head {
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.section-title {
  display: block;
  color: #222220;
  font-size: 31rpx;
  font-weight: 700;
}

.section-caption {
  display: block;
  margin-top: 6rpx;
  color: #686963;
  font-size: 24rpx;
  line-height: 1.45;
}

.section-note {
  max-width: 250rpx;
  color: #686963;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: right;
  white-space: normal;
}

.behavior-row {
  padding: 22rpx 0 20rpx;
  border-bottom: 1rpx solid #E4E1DA;
}

.behavior-row:last-child {
  border-bottom: 0;
}

.behavior-head,
.behavior-name {
  display: flex;
  align-items: center;
}

.behavior-head {
  justify-content: space-between;
  gap: 20rpx;
}

.behavior-name {
  min-width: 0;
  gap: 14rpx;
}

.behavior-mark {
  width: 26rpx;
  height: 8rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
}

.behavior-mark.meal,
.behavior-fill.meal {
  background: #E8A85A;
}

.behavior-mark.sleep,
.behavior-fill.sleep {
  background: #9B97B0;
}

.behavior-mark.play,
.behavior-fill.play {
  background: #5DB8A8;
}

.behavior-label {
  color: #222220;
  font-size: 27rpx;
  font-weight: 650;
}

.behavior-value {
  min-width: 110rpx;
  color: #222220;
  font-size: 29rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.behavior-track {
  position: relative;
  height: 12rpx;
  margin-top: 15rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #E8E5DF;
}

.behavior-range {
  display: none;
}

.behavior-fill {
  height: 100%;
  min-width: 0;
  border-radius: 999rpx;
}

.behavior-row.unavailable .behavior-track {
  height: 10rpx;
  border: 1rpx dashed #C9C6BF;
  background: transparent;
}

.behavior-row.unavailable .behavior-fill {
  display: none;
}

.behavior-helper {
  display: block;
  margin-top: 9rpx;
  color: #686963;
  font-size: 24rpx;
  line-height: 1.4;
}

.timeline-panel {
  margin-top: 32rpx;
  padding: 28rpx;
  border: 1rpx solid #E4E1DA;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.timeline-track {
  height: 18rpx;
  background: #E8E5DF;
}

.timeline-sleep { background: #9B97B0; }
.timeline-play { background: #5DB8A8; }
.timeline-food { background: #E8A85A; }
.timeline-dream { background: #7C9CA2; }
.timeline-idle { background: #D8D5CE; }

.timeline-legend {
  gap: 14rpx 26rpx;
  color: #686963;
  font-size: 24rpx;
}

.timeline-legend view {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-mark {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.legend-mark.sleep { background: #9B97B0; }
.legend-mark.play { background: #5DB8A8; }
.legend-mark.food { background: #E8A85A; }
.legend-mark.dream { background: #7C9CA2; }

.notice-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(240, 95, 101, 0.36);
  border-radius: 22rpx;
  background: #FFF7F5;
  box-shadow: none;
  color: #686963;
  font-size: 26rpx;
  text-align: left;
}

.notice-title {
  color: #B94249;
  font-size: 26rpx;
  font-weight: 700;
}

.customize-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 18rpx 0 0;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #E4E1DA;
  color: #686963;
  font-size: 24rpx;
  text-align: left;
}

.entry-arrow {
  color: #F05F65;
  font-size: 30rpx;
}

.dash-setting:active,
.settings-popover-close:active,
.settings-option:active,
.customize-entry:active {
  opacity: 0.68;
}

@media (max-height: 700px) {
  .dashboard-page {
    padding-top: 24rpx;
  }

  .dash-header {
    margin-bottom: 20rpx;
  }

  .hero-state {
    font-size: 52rpx;
  }

  .overview-stage {
    height: 376rpx;
  }

  .overview-stage .hero-cat {
    bottom: -48rpx;
    transform: scale(0.7);
  }
}

@media (prefers-reduced-motion: reduce) {
  .animated-cat,
  .cat-part,
  .cat-head-wrap,
  .sleep-zzz,
  .munch-bit,
  .impact-lines,
  .behavior-fill {
    animation: none !important;
    transition: none !important;
  }
}
